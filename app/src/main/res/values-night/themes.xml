<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyListApp" parent="Theme.Material3.DayNight">
        <!-- Customize your dark theme here. -->
        <!-- Primary (Dark Variant) -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>

        <!-- Secondary (Dark Variant) -->
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>

        <!-- Background/Surface (Dark Variant) -->
        <item name="android:windowBackground">@color/md_theme_dark_background</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/md_theme_dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MyListApp" parent="Base.Theme.MyListApp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Specific theme for Acvities that need an Action Bar -->
    <style name="Theme.MyApplication.WithActionBar" parent="Base.Theme.MyListApp">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>
</resources>