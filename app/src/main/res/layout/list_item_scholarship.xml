<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivScholarshipPhoto"
        android:layout_width="70dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tvScholarshipName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivScholarshipPhoto"
        app:layout_constraintTop_toTopOf="@id/ivScholarshipPhoto"
        tools:text="@string/scholarship_name" />

    <TextView
        android:id="@+id/tvScholarshipDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="5"
        app:layout_constraintBottom_toBottomOf="@id/ivScholarshipPhoto"
        app:layout_constraintEnd_toEndOf="@id/tvScholarshipName"
        app:layout_constraintStart_toStartOf="@id/tvScholarshipName"
        app:layout_constraintTop_toBottomOf="@id/tvScholarshipName"
        app:layout_constraintVertical_bias="0.0"
        tools:text="@string/description" />


</androidx.constraintlayout.widget.ConstraintLayout>